# Copy to .env only when preparing your own private hosted event.
# Start.command / Start.cmd / start.sh always force the invented demo.
GOLF_MODE=production
GOLF_CONFIG=.local/production/tournament.json
GOLF_POLL_CONFIG=.local/production/poll.json
GOLF_PROPOSALS_CONFIG=.local/production/proposals.json
GOLF_DATA_DIR=.local/production
GOLF_ACCESS_FILE=.local/production/access.json
GOLF_PUBLIC_ORIGIN=https://golf.example.invalid
PORT=5088
GOLF_STORAGE=local

# Optional hosted Redis. Leave blank when using local storage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional scorecard reading. Manual entry needs neither an account nor a key.
GOLF_OCR_ENABLED=no
GEMINI_API_KEY=
GEMINI_MODEL=
GOLF_OCR_DAILY_LIMIT=20

# Optional US forecast source. See docs/HOSTING.md for grid coordinates.
GOLF_WEATHER_ENABLED=no
GOLF_NWS_OFFICE=
GOLF_NWS_GRID_X=
GOLF_NWS_GRID_Y=
GOLF_NWS_USER_AGENT=GolfTripWorkshop/1.0
GOLF_NWS_DISCUSSION=no

# Optional model-written forecast summary, independently opt-in.
GOLF_WEATHER_SUMMARY_ENABLED=no
GOLF_WEATHER_SUMMARY_DAILY_LIMIT=4
